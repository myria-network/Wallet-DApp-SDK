{
  "name": "@myria-network/dapp",
  "version": "0.3.0",
  "description": "Browser SDK for connecting MYRIA Wallet dApps and using MYRIA smart contracts",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": "./dist/myria-dapp.iife.js"
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "DATA_MODEL.md",
    "SECURITY.md",
    "examples"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myria-network/Wallet-DApp-SDK.git"
  },
  "homepage": "https://github.com/myria-network/Wallet-DApp-SDK#readme",
  "bugs": {
    "url": "https://github.com/myria-network/Wallet-DApp-SDK/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
